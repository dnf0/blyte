/target
Cargo.lock
**/*.rs.bk
*.tmp
.DS_Store

# Ephemeral agent execution state & file locks
.agent-state/
.worktrees/
.wt/

# Graphify knowledge graph outputs
graphify-out/

# Secrets. Never commit. Holds GEMINI_API_KEY.
# `*.env` is needed as well as `.env`: the first two patterns miss `secrets.env`,
# which is exactly the gap test_no_secrets_committed.py caught.
.env
.env.*
*.env
!.env.example

# Per-task agent scratch (briefs, reports, review diffs). Plans and specs are dated.
docs/superpowers/plans/task-*
docs/superpowers/plans/*.diff
docs/plans/task-*
docs/plans/*.diff
site/
