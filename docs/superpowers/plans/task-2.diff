+        "toolCall": {
+            "name": "run_command",
+            "args": {
+                "command": "cargo test"
+            }
+        }
+    })
+    .to_string();
+
+    let (code, _, json) = run_guard(&payload, &[]);
+    assert_eq!(code, 0);
+    assert_eq!(json["decision"], "allow");
+}
+
+#[test]
+fn test_missing_or_empty_path_allows() {
+    let payload_missing = serde_json::json!({
+        "toolCall": {
