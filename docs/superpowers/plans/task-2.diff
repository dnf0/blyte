+            "args": {}
+        }
+    })
+    .to_string();
+
+    let (code, _, json) = run_guard(&payload_missing, &[]);
+    assert_eq!(code, 0);
+    assert_eq!(json["decision"], "allow");
+
+    let payload_empty = serde_json::json!({
+        "toolCall": {
+            "name": "view_file",
+            "args": {
+                "AbsolutePath": "   "
+            }
+        }
+    })
+    .to_string();
+
+    let (code, _, json) = run_guard(&payload_empty, &[]);
+    assert_eq!(code, 0);
+    assert_eq!(json["decision"], "allow");
+}
+
+#[test]
+fn test_non_existent_file_allows() {
