diff --git a/crates/superstate-provider/src/ollama.rs b/crates/superstate-provider/src/ollama.rs
new file mode 100644
index 0000000..9549aa5
--- /dev/null
+++ b/crates/superstate-provider/src/ollama.rs
@@ -0,0 +1,447 @@
+//! Ollama Cloud and custom endpoint provider adapter (`POST /chat` and `GET /tags`).
+//!
+//! # Protocol and Wire Format
+//!
+//! Ollama provides OpenAI-compatible chat endpoints with streaming, tool-calling, and model tag inspection.
+//! This adapter supports both Ollama Cloud (`https://ollama.com/api`) with Bearer token authentication and
+//! custom local/remote `$OLLAMA_HOST` endpoints:
+//! - An assistant turn issues tool calls via `{"role": "assistant", "tool_calls": [{"id": "...", "type": "function", "function": {"name": "...", "arguments": {...}}}]}`.
+//! - A tool response is sent via `{"role": "tool", "content": "..."}`.
+//! - The system prompt is passed as an initial message with `{"role": "system", "content": "..."}` within the messages array.
+//! - Model discovery is performed via `GET /api/tags` parsing the `models` array and details.
+
+use serde_json::{json, Value};
+
+use crate::{Message, ModelInfo, Provider, ProviderError, Request, Response, ToolCall, Usage};
+
+/// Default model identifier when `SUPERSTATE_MODEL` is not specified in the environment.
+const DEFAULT_MODEL: &str = "qwen2.5-coder:32b";
+
+/// Default base URL for Ollama Cloud API.
+const DEFAULT_API_ROOT: &str = "https://ollama.com/api";
+
+/// Connection timeout in seconds.
+///
+/// Bounded to prevent silent indefinite hanging if the network or gateway is unresponsive.
+const CONNECT_TIMEOUT_SECS: u64 = 20;
+
+/// Read timeout in seconds.
+///
+/// Long conversations or local model generation runs on large models can take several minutes.
+const READ_TIMEOUT_SECS: u64 = 300;
+
+/// Ollama Cloud and local/remote endpoint provider adapter.
+pub struct Ollama {
+    api_key: Option<String>,
+    api_root: String,
+    model: String,
+}
+
+impl Ollama {
+    /// Constructs an Ollama provider instance from environment variables.
+    ///
+    /// Reads `OLLAMA_API_KEY` (optional for local hosts, required for Ollama Cloud),
+    /// `OLLAMA_HOST` (optional, defaults to `https://ollama.com/api`), and `SUPERSTATE_MODEL`
+    /// (optional, defaults to `qwen2.5-coder:32b`).
+    ///
+    /// # Returns
+    /// An initialized [`Ollama`] instance on success.
+    ///
+    /// # Errors
+    /// Returns [`ProviderError::MissingKey`] if neither `OLLAMA_API_KEY` nor `OLLAMA_HOST` is set.
+    pub fn from_env() -> Result<Self, ProviderError> {
+        // Read optional API key, treating whitespace-only values as unset.
+        let api_key = std::env::var("OLLAMA_API_KEY")
+            .ok()
+            .filter(|k| !k.trim().is_empty());
+
+        // Read optional custom host root, stripping trailing slashes for clean path joining.
+        let host = std::env::var("OLLAMA_HOST")
+            .ok()
+            .filter(|h| !h.trim().is_empty());
+
+        // Require at least one configuration vector so callers receive clear diagnostics.
+        if api_key.is_none() && host.is_none() {
+            return Err(ProviderError::MissingKey("OLLAMA_API_KEY"));
+        }
+
+        // Default to Ollama Cloud API root when no host override is specified.
+        let api_root = host
+            .map(|h| h.trim_end_matches('/').to_string())
+            .unwrap_or_else(|| DEFAULT_API_ROOT.to_string());
+
+        // Strip any provider prefix to keep wire requests clean while accepting uniform IDs.
+        let raw_model =
+            std::env::var("SUPERSTATE_MODEL").unwrap_or_else(|_| DEFAULT_MODEL.to_string());
+        let model = raw_model
+            .strip_prefix("ollama/")
+            .unwrap_or(&raw_model)
+            .to_string();
+
+        Ok(Self {
+            api_key,
+            api_root,
+            model,
+        })
+    }
+
+    /// Sets the model identifier to use for completion requests.
+    ///
+    /// # Parameters
+    /// - `model`: A model identifier string or tag name.
+    ///
+    /// # Returns
+    /// The updated [`Ollama`] instance.
+    pub fn with_model(mut self, model: impl Into<String>) -> Self {
+        let m = model.into();
+        self.model = m.strip_prefix("ollama/").unwrap_or(&m).to_string();
+        self
+    }
+
+    /// Sets the API root URL for Ollama requests.
+    ///
+    /// Trailing slashes are stripped to maintain consistent URL composition.
+    ///
+    /// # Parameters
+    /// - `api_root`: Base URL string (e.g. `https://ollama.com/api` or `http://localhost:11434`).
+    ///
+    /// # Returns
+    /// The updated [`Ollama`] instance.
+    pub fn with_api_root(mut self, api_root: impl Into<String>) -> Self {
+        self.api_root = api_root.into().trim_end_matches('/').to_string();
+        self
+    }
+
+    /// Sets or overrides the API key for Bearer authentication.
+    ///
+    /// # Parameters
+    /// - `key`: API token string.
+    ///
+    /// # Returns
+    /// The updated [`Ollama`] instance.
+    pub fn with_api_key(mut self, key: impl Into<String>) -> Self {
+        self.api_key = Some(key.into());
+        self
+    }
+
+    /// Returns the configured API root base URL.
+    pub fn api_root(&self) -> &str {
+        &self.api_root
+    }
+
+    /// Returns the configured API key if one was provided.
+    pub fn api_key(&self) -> Option<&str> {
+        self.api_key.as_deref()
+    }
+
+    /// Returns the active model identifier without provider prefix.
+    pub fn model(&self) -> &str {
+        &self.model
+    }
+
+    /// Serializes a normalised [`Request`] into Ollama's `POST /chat` JSON body.
+    ///
+    /// # Parameters
+    /// - `req`: The generic turn request containing conversation messages, system prompt, and tools.
+    ///
+    /// # Returns
+    /// A [`Value`] JSON object adhering to Ollama's chat completion schema.
+    pub fn body(&self, req: &Request) -> Value {
+        let mut messages: Vec<Value> = Vec::new();
+
+        // System prompt is passed as the first message with role "system" when non-empty.
+        if !req.system.trim().is_empty() {
+            messages.push(json!({
+                "role": "system",
+                "content": req.system,
+            }));
+        }
+
+        // Map conversation turns into Ollama wire message objects.
+        for m in &req.messages {
+            match m {
+                Message::User(text) => {
+                    messages.push(json!({
+                        "role": "user",
+                        "content": text,
+                    }));
+                }
+                Message::Assistant(text) => {
+                    messages.push(json!({
+                        "role": "assistant",
+                        "content": text,
+                    }));
+                }
+                Message::ToolCall {
+                    id,
+                    name,
+                    arguments,
+                    ..
+                } => {
+                    // Assistant tool invocations are represented with role "assistant" and tool_calls array.
+                    messages.push(json!({
+                        "role": "assistant",
+                        "content": "",
+                        "tool_calls": [{
+                            "id": id,
+                            "type": "function",
+                            "function": {
+                                "name": name,
+                                "arguments": arguments,
+                            }
+                        }]
+                    }));
+                }
+                Message::ToolResult { content, .. } => {
+                    // Tool execution results are returned with role "tool".
+                    messages.push(json!({
+                        "role": "tool",
+                        "content": content,
+                    }));
+                }
+            }
+        }
+
+        let mut body = json!({
+            "model": self.model,
+            "stream": false,
+            "messages": messages,
+        });
+
+        // Tools schema is attached under "tools" using standard OpenAI-compatible function descriptors.
+        if !req.tools.is_empty() {
+            let tools_json: Vec<Value> = req
+                .tools
+                .iter()
+                .map(|t| {
+                    json!({
+                        "type": "function",
+                        "function": {
+                            "name": t.name,
+                            "description": t.description,
+                            "parameters": t.parameters,
+                        }
+                    })
+                })
+                .collect();
+            body["tools"] = json!(tools_json);
+        }
+
+        body
+    }
+
+    /// Parses an Ollama `POST /chat` response JSON payload into a normalised [`Response`].
+    ///
+    /// # Parameters
+    /// - `v`: The JSON response payload returned by the chat completion endpoint.
+    ///
+    /// # Returns
+    /// A normalised [`Response`] containing text output, tool invocations, and token usage.
+    ///
+    /// # Errors
+    /// Returns [`ProviderError::Parse`] if the payload reports an error or lacks a valid `message` object.
+    pub fn parse(v: &Value) -> Result<Response, ProviderError> {
+        // Intercept provider error messages in the body and fail fast.
+        if let Some(err) = v.get("error") {
+            if !err.is_null() {
+                let msg = if let Some(s) = err.as_str() {
+                    s.to_string()
+                } else if let Some(s) = err.get("message").and_then(|m| m.as_str()) {
+                    s.to_string()
+                } else {
+                    err.to_string()
+                };
+                return Err(ProviderError::Parse(msg));
+            }
+        }
+
+        // Ensure the assistant message object is present in the response.
+        let message = v
+            .get("message")
+            .and_then(|m| m.as_object())
+            .ok_or_else(|| ProviderError::Parse(format!("no message object in response: {v}")))?;
+
+        // Extract primary textual output if available.
+        let text = message
+            .get("content")
+            .and_then(|c| c.as_str())
+            .unwrap_or_default()
+            .to_string();
+
+        // Parse tool calls from message.tool_calls array.
+        let mut tool_calls = Vec::new();
+        if let Some(calls) = message.get("tool_calls").and_then(|c| c.as_array()) {
+            for (i, call) in calls.iter().enumerate() {
+                let function = call.get("function");
+                let name = function
+                    .and_then(|f| f.get("name"))
+                    .and_then(|n| n.as_str())
+                    .unwrap_or_default()
+                    .to_string();
+
+                // Ollama tool call arguments can arrive as pre-parsed JSON objects or serialized strings.
+                let arguments = match function.and_then(|f| f.get("arguments")) {
+                    Some(Value::Object(map)) => Value::Object(map.clone()),
+                    Some(Value::String(s)) => serde_json::from_str(s).unwrap_or_else(|_| json!({})),
+                    _ => json!({}),
+                };
+
+                // Fall back to synthetic call ID if the provider did not supply one.
+                let id = call
+                    .get("id")
+                    .and_then(|id_val| id_val.as_str())
+                    .map(String::from)
+                    .unwrap_or_else(|| format!("call_{i}"));
+
+                tool_calls.push(ToolCall {
+                    id,
+                    name,
+                    arguments,
+                    signature: None,
+                });
+            }
+        }
+
+        // Finish reason is extracted from done_reason if present.
+        let finish_reason = v
+            .get("done_reason")
+            .and_then(|r| r.as_str())
+            .map(String::from);
+
+        // Usage statistics from prompt_eval_count and eval_count.
+        let usage = Usage {
+            input: v
+                .get("prompt_eval_count")
+                .and_then(|x| x.as_u64())
+                .unwrap_or(0),
+            cached: 0,
+            output: v.get("eval_count").and_then(|x| x.as_u64()).unwrap_or(0),
+            thinking: 0,
+        };
+
+        Ok(Response {
+            text,
+            tool_calls,
+            usage,
+            finish_reason,
+        })
+    }
+
+    /// Parses a model listing JSON payload from `GET /tags`.
+    ///
+    /// # Parameters
+    /// - `v`: The JSON response payload returned by the tags endpoint.
+    ///
+    /// # Returns
+    /// A vector of [`ModelInfo`] describing available models and their quantization/parameter details.
+    ///
+    /// # Errors
+    /// Returns [`ProviderError::Parse`] if the payload cannot be parsed.
+    pub fn parse_models_list(v: &Value) -> Result<Vec<ModelInfo>, ProviderError> {
+        let mut out = Vec::new();
+
+        // Ollama returns models in an array under the "models" key.
+        if let Some(models) = v.get("models").and_then(|m| m.as_array()) {
+            for m in models {
+                let name = m.get("name").and_then(|n| n.as_str()).unwrap_or_default();
+                if name.is_empty() {
+                    continue;
+                }
+
+                // Format model details (parameter size and quantization level) into a concise description.
+                let description = m.get("details").and_then(|d| {
+                    let param_size = d.get("parameter_size").and_then(|s| s.as_str());
+                    let quant = d.get("quantization_level").and_then(|q| q.as_str());
+                    match (param_size, quant) {
+                        (Some(p), Some(q)) => Some(format!("{p}, {q}")),
+                        (Some(p), None) => Some(p.to_string()),
+                        (None, Some(q)) => Some(q.to_string()),
+                        (None, None) => None,
+                    }
+                });
+
+                out.push(ModelInfo {
+                    id: name.to_string(),
+                    display_name: name.to_string(),
+                    description,
+                    provider: "ollama".to_string(),
+                });
+            }
+        }
+
+        Ok(out)
+    }
+}
+
+impl Provider for Ollama {
+    /// Executes a synchronous completion request to Ollama's `POST /chat` endpoint.
+    ///
+    /// Attaches Bearer authentication header when `api_key` is present.
+    fn complete(&self, req: &Request) -> Result<Response, ProviderError> {
+        let url = format!("{}/chat", self.api_root);
+        let agent = ureq::AgentBuilder::new()
+            .timeout_connect(std::time::Duration::from_secs(CONNECT_TIMEOUT_SECS))
+            .timeout_read(std::time::Duration::from_secs(READ_TIMEOUT_SECS))
+            .build();
+        let mut req_builder = agent.post(&url).set("content-type", "application/json");
+
+        // Attach Authorization header if credentials are configured.
+        if let Some(ref key) = self.api_key {
+            req_builder = req_builder.set("Authorization", &format!("Bearer {key}"));
+        }
+
+        let resp = req_builder.send_json(self.body(req));
+
+        match resp {
+            Ok(r) => {
+                let v: Value = r
+                    .into_json()
+                    .map_err(|e| ProviderError::Parse(e.to_string()))?;
+                Self::parse(&v)
+            }
+            Err(ureq::Error::Status(status, r)) => Err(ProviderError::Api {
+                status,
+                body: r.into_string().unwrap_or_default(),
+            }),
+            Err(e) => Err(ProviderError::Transport(e.to_string())),
+        }
+    }
+
+    /// Returns the provider telemetry identifier (e.g. `ollama/qwen2.5-coder:32b`).
+    fn model_id(&self) -> String {
+        format!("ollama/{}", self.model)
+    }
+
+    /// Discovers available models by querying `GET /tags`.
+    ///
+    /// Attaches Bearer authentication header when `api_key` is present.
+    fn list_models(&self) -> Result<Vec<ModelInfo>, ProviderError> {
+        let url = format!("{}/tags", self.api_root);
+        let agent = ureq::AgentBuilder::new()
+            .timeout_connect(std::time::Duration::from_secs(CONNECT_TIMEOUT_SECS))
+            .timeout_read(std::time::Duration::from_secs(READ_TIMEOUT_SECS))
+            .build();
+        let mut req_builder = agent.get(&url);
+
+        // Attach Authorization header if credentials are configured.
+        if let Some(ref key) = self.api_key {
+            req_builder = req_builder.set("Authorization", &format!("Bearer {key}"));
+        }
+
+        let resp = req_builder.call();
+
+        match resp {
+            Ok(r) => {
+                let v: Value = r
+                    .into_json()
+                    .map_err(|e| ProviderError::Parse(e.to_string()))?;
+                Self::parse_models_list(&v)
+            }
+            Err(ureq::Error::Status(status, r)) => Err(ProviderError::Api {
+                status,
+                body: r.into_string().unwrap_or_default(),
+            }),
+            Err(e) => Err(ProviderError::Transport(e.to_string())),
+        }
+    }
+}
diff --git a/crates/superstate-provider/src/registry.rs b/crates/superstate-provider/src/registry.rs
new file mode 100644
index 0000000..bb02be7
--- /dev/null
+++ b/crates/superstate-provider/src/registry.rs
@@ -0,0 +1,146 @@
+//! Universal model routing, provider resolution, and multi-provider credential discovery.
+//!
+//! Provides a single entrypoint for mapping user-provided model identifiers or ambient
+//! environment credentials to concrete [`Provider`] implementations, insulating callers
+//! from provider-specific wire schemas and credential conventions.
+
+use crate::{ModelInfo, Provider, ProviderError};
+
+/// Identifies the underlying AI backend provider family.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProviderKind {
+    /// Google Gemini models (e.g., `gemini-3.8-flash`, `gemini-2.5-pro`).
+    Gemini,
+    /// Anthropic Claude models (e.g., `claude-3-7-sonnet`, `claude-3-5-haiku`).
+    Anthropic,
+    /// Ollama local or Cloud hosted models (e.g., `qwen2.5-coder:32b`, `llama3.3:70b`).
+    Ollama,
+}
+
+/// Detects the target [`ProviderKind`] based on model naming conventions or environment credentials.
+///
+/// Discovers provider kind through explicit namespace prefixes (`anthropic/`, `gemini/`, `ollama/`),
+/// well-known model prefix tags (`claude`, `gemini`), or tag syntax (`:`). If no model is supplied
+/// or the identifier is unrecognized, falls back to inspecting ambient environment variables.
+///
+/// # Parameters
+/// * `model` - Optional model identifier string or prefixed specification.
+///
+/// # Returns
+/// The resolved [`ProviderKind`].
+pub fn detect_provider_kind(model: Option<&str>) -> ProviderKind {
+    // 1. Inspect explicit prefix or well-known model family patterns
+    if let Some(m) = model {
+        if m.starts_with("claude") || m.starts_with("anthropic/") || m == "anthropic" {
+            return ProviderKind::Anthropic;
+        }
+        if m.starts_with("ollama/") || m == "ollama" || m.contains(':') {
+            return ProviderKind::Ollama;
+        }
+        if m.starts_with("gemini") || m.starts_with("gemini/") {
+            return ProviderKind::Gemini;
+        }
+    }
+
+    // 2. Fall back to ambient environment credentials when model is unspecified or ambiguous
+    if std::env::var("GEMINI_API_KEY").is_ok() || std::env::var("GOOGLE_API_KEY").is_ok() {
+        ProviderKind::Gemini
+    } else if std::env::var("ANTHROPIC_API_KEY").is_ok() {
+        ProviderKind::Anthropic
+    } else if std::env::var("OLLAMA_API_KEY").is_ok() || std::env::var("OLLAMA_HOST").is_ok() {
+        ProviderKind::Ollama
+    } else {
+        // Default baseline fallback is Gemini
+        ProviderKind::Gemini
+    }
+}
+
+/// Resolves a model identifier into a heap-allocated [`Provider`] instance configured with credentials.
+///
+/// Strips provider namespace prefixes (`anthropic/`, `gemini/`, `ollama/`) from the model identifier
+/// before configuring the underlying adapter. If credentials for the detected provider are missing
+/// in the environment, returns a descriptive [`ProviderError::MissingKey`].
+///
+/// # Parameters
+/// * `model` - Optional model name or namespaced identifier.
+///
+/// # Returns
+/// Returns a boxed dynamic [`Provider`] ready for completion requests, or a [`ProviderError`].
+pub fn resolve_provider(model: Option<&str>) -> Result<Box<dyn Provider>, ProviderError> {
+    // Determine provider kind first so routing logic is unified
+    let kind = detect_provider_kind(model);
+
+    // Strip provider prefix from model string if present, treating bare provider names as default
+    let clean_model = match model {
+        Some("anthropic") | Some("ollama") | Some("gemini") => None,
+        Some(m) => {
+            let stripped = if let Some(s) = m.strip_prefix("anthropic/") {
+                s
+            } else if let Some(s) = m.strip_prefix("gemini/") {
+                s
+            } else if let Some(s) = m.strip_prefix("ollama/") {
+                s
+            } else {
+                m
+            };
+            if stripped.is_empty() {
+                None
+            } else {
+                Some(stripped)
+            }
+        }
+        None => None,
+    };
+
+    // Instantiate provider adapter and apply stripped model identifier override if provided
+    match kind {
+        ProviderKind::Gemini => {
+            let mut p = crate::gemini::Gemini::from_env()?;
+            if let Some(m) = clean_model {
+                p = p.with_model(m);
+            }
+            Ok(Box::new(p))
+        }
+        ProviderKind::Anthropic => {
+            let mut p = crate::anthropic::Anthropic::from_env()?;
+            if let Some(m) = clean_model {
+                p = p.with_model(m);
+            }
+            Ok(Box::new(p))
+        }
+        ProviderKind::Ollama => {
+            let mut p = crate::ollama::Ollama::from_env()?;
+            if let Some(m) = clean_model {
+                p = p.with_model(m);
+            }
+            Ok(Box::new(p))
+        }
+    }
+}
+
+/// Probes all supported providers in the current environment and lists available models.
+///
+/// Each provider is queried using its environment credentials. Providers with missing keys
+/// or network errors report their individual [`ProviderError`] without halting discovery
+/// of remaining providers.
+///
+/// # Returns
+/// A vector of tuples containing human-friendly provider labels and either the list of
+/// discovered [`ModelInfo`] records or the error encountered while querying.
+pub fn discover_all_models() -> Vec<(String, Result<Vec<ModelInfo>, ProviderError>)> {
+    // Query each provider adapter sequentially, collecting successful models or failure errors
+    vec![
+        match crate::gemini::Gemini::from_env() {
+            Ok(p) => ("Google Gemini".to_string(), p.list_models()),
+            Err(e) => ("Google Gemini".to_string(), Err(e)),
+        },
+        match crate::anthropic::Anthropic::from_env() {
+            Ok(p) => ("Anthropic Claude".to_string(), p.list_models()),
+            Err(e) => ("Anthropic Claude".to_string(), Err(e)),
+        },
+        match crate::ollama::Ollama::from_env() {
+            Ok(p) => ("Ollama Cloud".to_string(), p.list_models()),
+            Err(e) => ("Ollama Cloud".to_string(), Err(e)),
+        },
+    ]
+}
diff --git a/crates/superstate-provider/tests/test_anthropic_wire.rs b/crates/superstate-provider/tests/test_anthropic_wire.rs
new file mode 100644
index 0000000..c8e8f14
--- /dev/null
+++ b/crates/superstate-provider/tests/test_anthropic_wire.rs
@@ -0,0 +1,280 @@
+//! The Anthropic Claude request/response mapping and model discovery, tested without a network.
+//!
+//! Wire translations are tested offline to verify formatting, role mappings, tool handling,
+//! token usage accounting, and model listing without requiring live credentials or network access.
+
+use std::sync::Mutex;
+
+use serde_json::json;
+use superstate_provider::anthropic::Anthropic;
+use superstate_provider::{Message, Provider, ProviderError, Request, ToolSpec, Usage};
+
+/// Lock to serialize tests modifying process-wide environment variables.
+static ENV_LOCK: Mutex<()> = Mutex::new(());
+
+fn anthropic() -> Anthropic {
+    std::env::set_var("ANTHROPIC_API_KEY", "test-key-not-real");
+    Anthropic::from_env().unwrap()
+}
+
+fn tool() -> ToolSpec {
+    ToolSpec {
+        name: "read_file".into(),
+        description: "Read a file".into(),
+        parameters: json!({"type":"object","properties":{"path":{"type":"string"}}}),
+    }
+}
+
+#[test]
+fn system_instruction_is_placed_in_top_level_system_field() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let req = Request {
+        system: "You are an assistant.".into(),
+        messages: vec![Message::User("hi".into())],
+        ..Default::default()
+    };
+    let b = anthropic().body(&req);
+    assert_eq!(b["system"], "You are an assistant.");
+    assert_eq!(
+        b["messages"].as_array().unwrap().len(),
+        1,
+        "system prompt must not be included in messages"
+    );
+    assert_eq!(b["model"], "claude-3-7-sonnet-latest");
+    assert_eq!(b["max_tokens"], 8192);
+}
+
+#[test]
+fn empty_system_instruction_is_omitted() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let req = Request {
+        system: "".into(),
+        messages: vec![Message::User("hi".into())],
+        ..Default::default()
+    };
+    let b = anthropic().body(&req);
+    assert!(b.get("system").is_none());
+}
+
+#[test]
+fn custom_max_output_tokens_is_respected() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let req = Request {
+        max_output_tokens: Some(4096),
+        messages: vec![Message::User("hi".into())],
+        ..Default::default()
+    };
+    let b = anthropic().body(&req);
+    assert_eq!(b["max_tokens"], 4096);
+}
+
+#[test]
+fn user_and_assistant_message_content_blocks() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let req = Request {
+        messages: vec![
+            Message::User("hello".into()),
+            Message::Assistant("hi".into()),
+        ],
+        ..Default::default()
+    };
+    let b = anthropic().body(&req);
+    assert_eq!(b["messages"][0]["role"], "user");
+    assert_eq!(b["messages"][0]["content"][0]["type"], "text");
+    assert_eq!(b["messages"][0]["content"][0]["text"], "hello");
+
+    assert_eq!(b["messages"][1]["role"], "assistant");
+    assert_eq!(b["messages"][1]["content"][0]["type"], "text");
+    assert_eq!(b["messages"][1]["content"][0]["text"], "hi");
+}
+
+#[test]
+fn tool_call_and_tool_result_wire_shape() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let req = Request {
+        messages: vec![
+            Message::User("read file".into()),
+            Message::ToolCall {
+                id: "toolu_123".into(),
+                name: "read_file".into(),
+                arguments: json!({"path": "foo.rs"}),
+                signature: None,
+            },
+            Message::ToolResult {
+                id: "toolu_123".into(),
+                name: "read_file".into(),
+                content: "pub fn bar() {}".into(),
+                is_error: false,
+            },
+        ],
+        tools: vec![tool()],
+        ..Default::default()
+    };
+    let b = anthropic().body(&req);
+
+    // Assistant tool_use block
+    assert_eq!(b["messages"][1]["role"], "assistant");
+    assert_eq!(b["messages"][1]["content"][0]["type"], "tool_use");
+    assert_eq!(b["messages"][1]["content"][0]["id"], "toolu_123");
+    assert_eq!(b["messages"][1]["content"][0]["name"], "read_file");
+    assert_eq!(
+        b["messages"][1]["content"][0]["input"],
+        json!({"path": "foo.rs"})
+    );
+
+    // User tool_result block
+    assert_eq!(b["messages"][2]["role"], "user");
+    assert_eq!(b["messages"][2]["content"][0]["type"], "tool_result");
+    assert_eq!(b["messages"][2]["content"][0]["tool_use_id"], "toolu_123");
+    assert_eq!(b["messages"][2]["content"][0]["content"], "pub fn bar() {}");
+    assert_eq!(b["messages"][2]["content"][0]["is_error"], false);
+
+    // Tools schema
+    assert_eq!(b["tools"][0]["name"], "read_file");
+    assert_eq!(b["tools"][0]["description"], "Read a file");
+    assert_eq!(
+        b["tools"][0]["input_schema"],
+        json!({"type":"object","properties":{"path":{"type":"string"}}})
+    );
+}
+
+#[test]
+fn tools_omitted_when_empty() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let b = anthropic().body(&Request {
+        messages: vec![Message::User("hi".into())],
+        ..Default::default()
+    });
+    assert!(b.get("tools").is_none());
+}
+
+#[test]
+fn parses_text_and_tool_use_response() {
+    let v = json!({
+        "id": "msg_01X9vhvWxAE3JeewndpTxWs5",
+        "type": "message",
+        "role": "assistant",
+        "content": [
+            {"type": "text", "text": "I will inspect that for you."},
+            {"type": "tool_use", "id": "toolu_01A09q90tc1q", "name": "read_file", "input": {"path": "main.rs"}}
+        ],
+        "model": "claude-3-7-sonnet-20250219",
+        "stop_reason": "tool_use",
+        "usage": {
+            "input_tokens": 1200,
+            "cache_creation_input_tokens": 0,
+            "cache_read_input_tokens": 400,
+            "output_tokens": 80
+        }
+    });
+    let r = Anthropic::parse(&v).expect("parsing response should succeed");
+    assert_eq!(r.text, "I will inspect that for you.");
+    assert_eq!(r.tool_calls.len(), 1);
+    assert_eq!(r.tool_calls[0].id, "toolu_01A09q90tc1q");
+    assert_eq!(r.tool_calls[0].name, "read_file");
+    assert_eq!(r.tool_calls[0].arguments["path"], "main.rs");
+    assert_eq!(r.tool_calls[0].signature, None);
+    assert_eq!(r.finish_reason.as_deref(), Some("tool_use"));
+    assert_eq!(
+        r.usage,
+        Usage {
+            input: 800,
+            cached: 400,
+            output: 80,
+            thinking: 0,
+        }
+    );
+}
+
+#[test]
+fn response_with_no_usage_block_does_not_fail() {
+    let v = json!({
+        "content": [{"type": "text", "text": "hello"}]
+    });
+    let r = Anthropic::parse(&v).expect("should parse successfully");
+    assert_eq!(r.text, "hello");
+    assert_eq!(r.usage, Usage::default());
+}
+
+#[test]
+fn response_without_content_fails_parsing() {
+    let v = json!({
+        "type": "error",
+        "error": {
+            "type": "invalid_request_error",
+            "message": "max_tokens: 100000 > 8192"
+        }
+    });
+    let err = Anthropic::parse(&v);
+    assert!(
+        err.is_err(),
+        "response without a content array must fail parsing"
+    );
+}
+
+#[test]
+fn parse_models_list_extracts_models_and_adds_standard_aliases() {
+    let v = json!({
+        "data": [
+            {
+                "type": "model",
+                "id": "claude-3-5-sonnet-20241022",
+                "display_name": "Claude 3.5 Sonnet",
+                "created_at": "2024-10-22T00:00:00Z"
+            }
+        ]
+    });
+    let models = Anthropic::parse_models_list(&v).expect("parsing models list should succeed");
+    // Contains "claude-3-5-sonnet-20241022" plus the 3 standard aliases ("claude-3-7-sonnet-latest", "claude-3-5-sonnet-latest", "claude-3-5-haiku-latest").
+    assert_eq!(models.len(), 4);
+    assert!(models.iter().any(|m| m.id == "claude-3-5-sonnet-20241022"
+        && m.display_name == "Claude 3.5 Sonnet"
+        && m.provider == "anthropic"));
+    assert!(models
+        .iter()
+        .any(|m| m.id == "claude-3-7-sonnet-latest" && m.provider == "anthropic"));
+    assert!(models
+        .iter()
+        .any(|m| m.id == "claude-3-5-sonnet-latest" && m.provider == "anthropic"));
+    assert!(models
+        .iter()
+        .any(|m| m.id == "claude-3-5-haiku-latest" && m.provider == "anthropic"));
+}
+
+#[test]
+fn parse_models_list_handles_empty_or_missing_data() {
+    let empty = json!({"data": []});
+    let models = Anthropic::parse_models_list(&empty).expect("empty data should succeed");
+    assert_eq!(models.len(), 3);
+
+    let missing = json!({});
+    let models = Anthropic::parse_models_list(&missing).expect("missing data should succeed");
+    assert_eq!(models.len(), 3);
+}
+
+#[test]
+fn from_env_requires_api_key_and_honors_superstate_model() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    std::env::remove_var("ANTHROPIC_API_KEY");
+    assert!(matches!(
+        Anthropic::from_env(),
+        Err(ProviderError::MissingKey("ANTHROPIC_API_KEY"))
+    ));
+
+    std::env::set_var("ANTHROPIC_API_KEY", "test-key");
+    std::env::set_var("SUPERSTATE_MODEL", "claude-3-5-sonnet-20241022");
+    let a = Anthropic::from_env().expect("from_env should succeed when key is set");
+    assert_eq!(a.model_id(), "anthropic/claude-3-5-sonnet-20241022");
+
+    std::env::remove_var("SUPERSTATE_MODEL");
+    let a_default =
+        Anthropic::from_env().expect("from_env should default to claude-3-7-sonnet-latest");
+    assert_eq!(a_default.model_id(), "anthropic/claude-3-7-sonnet-latest");
+}
+
+#[test]
+fn with_model_updates_model_and_model_id() {
+    let _guard = ENV_LOCK.lock().unwrap();
+    let a = anthropic().with_model("claude-opus-4");
+    assert_eq!(a.model_id(), "anthropic/claude-opus-4");
+}
