+    assert_eq!(rep.gate_attempts, 1);
+
+    let seen = p.seen.lock().unwrap();
+    let Message::ToolResult {
+        content: content2,
+        is_error: err2,
+        ..
+    } = &seen[2].messages[4]
+    else {
+        panic!("expected ToolResult at index 4");
+    };
+    assert!(!err2);
+    assert!(!content2.contains("[Harness Working Memory Guard]"));
